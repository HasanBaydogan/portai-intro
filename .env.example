# Forms API base URL seen by the browser.
# Local (backend on this machine):
NEXT_PUBLIC_FORMS_API_URL=http://localhost:8090/api

# --- Vercel (recommended: same-origin proxy, avoids mixed-content) ---
# NEXT_PUBLIC_FORMS_API_URL=/api
# FORMS_BACKEND_URL=http://185.8.131.94:8091/api
# Redeploy after changing FORMS_BACKEND_URL (baked into next.config rewrites).

